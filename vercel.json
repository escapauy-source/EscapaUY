{
  "buildCommand": "npm run build:ssg",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "framework": null,
  "rewrites": [
    {
      "source": "/colonia/que-hacer",
      "destination": "/colonia/que-hacer/index.html"
    },
    {
      "source": "/carmelo/bodegas",
      "destination": "/carmelo/bodegas/index.html"
    },
    {
      "source": "/escapada-desde-buenos-aires",
      "destination": "/escapada-desde-buenos-aires/index.html"
    },
    {
      "source": "/hoteles/colonia",
      "destination": "/hoteles/colonia/index.html"
    },
    {
      "source": "/experiencias/enoturismo-uruguay",
      "destination": "/experiencias/enoturismo-uruguay/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/sitemap.xml",
      "headers": [
        { "key": "Content-Type", "value": "application/xml" },
        { "key": "Cache-Control", "value": "public, max-age=86400" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
